# ==============================================================================
# InstaPulse AI - Production Environment Variables
# ==============================================================================

# Application URL (Use your production domain in production, e.g. https://instapulse.ai)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth / Session Encryption Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=instapulse_ultra_secure_session_secret_change_me_in_production_2026

# ------------------------------------------------------------------------------
# Cloud AI Provider: Google Gemini API (Recommended & Production-Ready)
# Get your API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Alternative Instagram Scraper: Apify API (Recommended: Bypasses Meta Dev Approval)
# Get your free token at: https://apify.com (Settings -> Integrations -> API Tokens)
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=your_apify_token_here

# ------------------------------------------------------------------------------
# Meta Graph API / Instagram Graph API Configuration (Optional)
# Get your App ID and Secret at: https://developers.facebook.com/apps/
# Read META_APP_SETUP.md for complete step-by-step setup instructions
# ------------------------------------------------------------------------------
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# Graph API Version
META_GRAPH_API_VERSION=v19.0

